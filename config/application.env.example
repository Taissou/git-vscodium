# Exemple de variables d'environnement pour InfraLab (valeurs fictives, aucun secret).
# Pour l'utiliser : cp config/application.env.example config/application.env
# Le fichier application.env est ignoré par Git (voir .gitignore).
APP_NAME=infralab
APP_ENV=formation
APP_PORT=8080
DB_HOST=localhost
DB_PORT=5432
DB_NAME=infralab_demo
LOG_LEVEL=info
